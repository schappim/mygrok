# mygrokd systemd unit — reference copy.
#
# deploy/install-server.sh writes this for you with your values filled in.
# It's here for anyone configuring by hand or managing the box with Ansible,
# Chef, NixOS, or similar.
#
# Install:
#   sudo install -m 0644 deploy/mygrokd.service /etc/systemd/system/
#   sudo install -d -m 0755 /etc/mygrokd
#   printf 'MYGROK_AUTHTOKEN=%s\n' "$(openssl rand -hex 32)" \
#     | sudo install -m 0600 /dev/stdin /etc/mygrokd/mygrokd.env
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin mygrokd
#   sudo install -d -m 0700 -o mygrokd -g mygrokd /var/lib/mygrokd
#   sudo systemctl daemon-reload && sudo systemctl enable --now mygrokd

[Unit]
Description=mygrok tunnel server
Documentation=https://github.com/schappim/mygrok
After=network-online.target
Wants=network-online.target
# Give up after 5 failed starts in 5 minutes rather than restarting forever.
# A hot restart loop against Let's Encrypt burns the failed-validation limit
# and locks the operator out of certificates for an hour.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mygrokd
Group=mygrokd

# Holds MYGROK_AUTHTOKEN and, if you use one, the DNS provider's
# credentials. Keep it 0600 root:root — systemd reads it as root before
# dropping privileges, so the service user never needs access.
EnvironmentFile=/etc/mygrokd/mygrokd.env

ExecStart=/usr/local/bin/mygrokd \
  --public-host=example.com \
  --http=:80 \
  --https=:443 \
  --tunnel=:7000 \
  --dns-provider=none \
  --cert-email=you@example.com \
  --cert-dir=/var/lib/mygrokd/certs \
  --ip-list=/var/lib/mygrokd/iplist.json \
  --passkeys=/var/lib/mygrokd/passkeys.json \
  --tunnel-locks=/var/lib/mygrokd/tunnellocks.json \
  --invites=/var/lib/mygrokd/invites.json

Restart=always
RestartSec=10

# Bind :80/:443 as an unprivileged user. This has to be an ambient
# capability, not a setcap on the binary: NoNewPrivileges=true makes the
# kernel ignore file capabilities, so a setcap'd binary fails with
# "permission denied" on :80 and nothing explains why.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# The service only ever needs its own state directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mygrokd
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
